# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/cuci_sepatu_db?schema=public"

# ============================================
# NEXTAUTH
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters-long-change-this"

# ============================================
# BUSINESS (customer-facing)
# ============================================
# WhatsApp number that receives payment proof. Digits with country code, no "+" or spaces.
BUSINESS_WHATSAPP_NUMBER=""

# JSON array of the payment destinations customers are shown. Leave empty until you
# have the real account data: the app never falls back to example accounts, and the
# build fails while this is empty (set ALLOW_MISSING_BUSINESS_CONFIG=1 to skip locally).
#
# Shape:
# [
#   {
#     "method": "TRANSFER",
#     "name": "Transfer Bank",
#     "description": "Bank transfer",
#     "accounts": [{ "label": "BCA", "value": "<account number>", "holder": "<account holder>" }]
#   },
#   { "method": "COD", "name": "Bayar di Tempat", "note": "Bayar saat sepatu diambil." }
# ]
# Methods: TRANSFER | EWALLET | QRIS | COD.
# EWALLET uses "accounts" with the wallet number, QRIS uses "qrImageUrl" pointing at a
# raster file under /public (png/jpg; SVG cannot be optimized by next/image), COD uses
# "note" and needs no account.
PAYMENT_DESTINATIONS=""

 
 

 